<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 
    SearchMapper 인터페이스와 매핑되는 SQL을 작성합니다.
    namespace: Mapper 인터페이스의 전체 경로
-->
<mapper namespace="com.ssafy.search.mapper.SearchMapper">

    <!-- resultMap: DB 컬럼과 DTO 필드를 매핑 -->
    <resultMap id="sidoResultMap" type="com.ssafy.search.dto.Sido">
        <id property="sidoNo" column="sido_no"/>
        <result property="sidoName" column="sido_name"/>
    </resultMap>

    <!-- Gungu ResultMap -->
    <resultMap id="gunguResultMap" type="com.ssafy.search.dto.Gungu">
        <id property="sidoNo" column="sido_no"/>
        <id property="gunguCode" column="gungu_code"/>
        <result property="gunguName" column="gungu_name"/>
    </resultMap>
    
    <!-- MenuTag ResultMap -->
    <resultMap id="menuTagResultMap" type="com.ssafy.menu.dto.Tag">
        <id property="tagId" column="tag_id"/>
        <result property="tagName" column="tag_name"/>
        <result property="category" column="category"/>
    </resultMap>
    
    <!-- SearchRestaurant ResultMap -->
    <resultMap id="searchRestaurantResultMap" type="com.ssafy.search.dto.SearchRestaurant">
        <id property="id" column="restaurant_id"/>
        <result property="name" column="restaurant_name"/>
        <result property="category" column="category"/>
        <result property="address" column="address"/>
        <result property="lat" column="lat"/>
        <result property="lng" column="lng"/>
        <result property="phone" column="phone"/>
        <result property="mainImage" column="main_image"/>
        <result property="totalRating" column="total_rating"/>
        <result property="totalContents" column="total_contents"/>
        <result property="viewCount" column="view_count"/>
        <result property="reviewCounts" column="review_counts"/>
        
    </resultMap>
    
    <!-- 처음 검색 화면 시도 조회 -->
    <select id="getSidoList" resultMap="sidoResultMap" >
        SELECT sido_no, sido_name FROM sido ORDER BY sido_no
    </select>

    <!-- 시도 선택 시 군구 조회 -->
    <select id="getGunguList" parameterType="Sido" resultMap="gunguResultMap">
        SELECT * FROM gungu WHERE sido_no = #{sidoNo} ORDER BY gungu_code
    </select>
    
    <!-- 카테고리 선택 시 메뉴 태그 조회 -->
    <select id="getMenuTagList" parameterType="String" resultMap="menuTagResultMap">
        SELECT * FROM menu_tags WHERE category = #{category}
    </select>
    
    <!-- 메뉴 태그 전체 조회 -->
    <select id="getMenuTagListAll" resultMap="menuTagResultMap">
    	SELECT * FROM menu_tags; 
    </select> 
    
    <!-- 키워드를 모두 선택하고 검색 버튼 누를  식당 조회 -->
    <select id="searchRestaurantList" resultMap="searchRestaurantResultMap">

	    SELECT DISTINCT
	        r.restaurant_id, 
	        r.restaurant_name, 
	        r.category, 
	        r.address,
	        r.lat,
	        r.lng,
	        r.phone,
	        r.main_image,
	        r.total_rating,
	        r.total_contents,
	        r.view_count,
	        r.review_counts
	    FROM restaurants r
	    LEFT JOIN menu m 
	        ON r.restaurant_id = m.restaurant_id
	    LEFT JOIN menu_tags_mapping mtm 
	        ON m.menu_id = mtm.menu_id
	    LEFT JOIN menu_tags mt 
	        ON mtm.tag_id = mt.tag_id
	
	    <where>
	        1 = 1
	
	        <if test="keywords.sidoNo != null and keywords.sidoNo != '' and keywords.sidoNo != 'not'">
	            AND r.sido_no = #{keywords.sidoNo}
	        </if>
	
	        <if test="keywords.gunguCode != null and keywords.gunguCode != '' and keywords.gunguCode != 'not'">
	            AND r.gungu_code = #{keywords.gunguCode}
	        </if>
	
	        <if test="keywords.category != null and keywords.category != '' and keywords.category != 'not'">
	            AND r.category = #{keywords.category}
	        </if>
	
	        <if test="keywords.tagId != null and keywords.tagId != 0">
	            AND mt.tag_id = #{keywords.tagId}
	        </if>
	        
	        <!-- tagId가 없고 tagName이 있으면 메뉴 이름으로 검색 -->
	        <if test="(keywords.tagId == null or keywords.tagId == 0) and keywords.tagName != null and keywords.tagName != ''">
	            AND m.menu_name LIKE CONCAT('%', #{keywords.tagName}, '%')
	        </if>
	    </where>
		ORDER BY
	    <choose>
		    <!-- 최신순 (기본) -->
		    <when test="sort == null or sort == 'LATEST'">
		        r.restaurant_id DESC
		    </when>
		
		    <!-- 평점순 -->
		    <when test="sort == 'RATING'">
		        (r.total_rating / NULLIF(r.review_counts, 0)) DESC
		    </when>
		
		    <!-- 조회수순 -->
		    <when test="sort == 'VIEW'">
		        r.view_count DESC
		    </when>
		
		    <!-- 리뷰수순 -->
		    <when test="sort == 'REVIEW'">
		        r.total_contents DESC
		    </when>
		
		    <!-- 예외 대비 -->
		    <otherwise>
		        r.restaurant_id DESC
		    </otherwise>
		</choose>
	    LIMIT #{size} OFFSET #{offset}

	</select>
	
	<select id="searchRestaurantCount" resultType="int">
	    SELECT COUNT(DISTINCT r.restaurant_id)
	    FROM restaurants r
	    LEFT JOIN menu m ON r.restaurant_id = m.restaurant_id
	    LEFT JOIN menu_tags_mapping mtm ON m.menu_id = mtm.menu_id
	    <where>
	        1 = 1
	        <if test="sidoNo != null and sidoNo != '' and sidoNo != 'not'">
	            AND r.sido_no = #{sidoNo}
	        </if>
	        <if test="gunguCode != null and gunguCode != '' and gunguCode != 'not'">
	            AND r.gungu_code = #{gunguCode}
	        </if>
	        <if test="category != null and category != '' and category != 'not'">
	            AND r.category = #{category}
	        </if>
	        <if test="tagId != null and tagId != 0">
	            AND mtm.tag_id = #{tagId}
	        </if>
	        
	        <!-- tagId가 없고 tagName이 있으면 메뉴 이름으로 검색 -->
	        <if test="(tagId == null or tagId == 0) and tagName != null and tagName != ''">
	            AND m.menu_name LIKE CONCAT('%', #{tagName}, '%')
	        </if>
	    </where>
	</select>
    
    <!-- 시도명으로 군구 조회 -->
    <select id="getSidoToName" parameterType="String" resultMap="sidoResultMap">
	    SELECT *
	    FROM sido
	    WHERE sido_name = #{sidoName}
	</select>
	    
    <!-- 시도 코드와 군구명으로 군구 조회 -->
    <select id="getGunguToName" resultMap="gunguResultMap">
        SELECT * FROM gungu WHERE gungu_name = #{gunguName} AND sido_no = #{sidoNo}
    </select>
    
    <!-- 태그명으로 태그 조회 -->
    <select id="getMenuTagToName" parameterType="String" resultMap="menuTagResultMap">
        SELECT * FROM menu_tags WHERE tag_name = #{tagName}
    </select>
    
    
</mapper>