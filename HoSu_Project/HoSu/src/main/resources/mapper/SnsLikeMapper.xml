<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.sns.mapper.SnsLikeMapper">

    <!-- 좋아요 추가 -->
    <insert id="insertLike">
        INSERT INTO sns_like (board_id, user_no)
        VALUES (#{boardId}, #{userNo})
    </insert>

    <!-- 좋아요 삭제 -->
    <delete id="deleteLike">
        DELETE FROM sns_like
        WHERE board_id = #{boardId} AND user_no = #{userNo}
    </delete>

    <!-- 좋아요 여부 확인 -->
    <select id="existsLike" resultType="int">
        SELECT COUNT(*)
        FROM sns_like
        WHERE board_id = #{boardId} AND user_no = #{userNo}
    </select>

    <!-- 좋아요 수 조회 -->
    <select id="countLikes" resultType="int">
        SELECT COUNT(*)
        FROM sns_like
        WHERE board_id = #{boardId}
    </select>

</mapper>